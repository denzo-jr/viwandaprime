# Copy to .env before running: cp .env.example .env
DATABASE_URL="file:./dev.db"

# Any random string. Signs the session cookie.
AUTH_SECRET="change-me"

# Africa's Talking. Leave AT_API_KEY blank to run in simulator mode:
# messages are stored and shown in the in-app SMS inbox instead of being sent.
AT_USERNAME="sandbox"
AT_API_KEY=""
AT_SENDER_ID="VIWANDA"
