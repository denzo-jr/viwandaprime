# Copy to .env before running: cp .env.example .env
DATABASE_URL="file:./dev.db"

# Any random string. Signs the session cookie.
AUTH_SECRET="change-me"

# ---------------------------------------------------------------------------
# Africa's Talking
# ---------------------------------------------------------------------------
# Leave AT_API_KEY blank to run in simulator mode: messages are stored and shown
# in the in-app SMS inbox instead of being sent anywhere.
#
# AT_USERNAME=sandbox  -> real API calls, but delivery only ever reaches the
#                         Africa's Talking simulator, never a real handset.
# A live username      -> real SMS to real phones. Costs money.
AT_USERNAME="sandbox"
AT_API_KEY=""

# Alphanumeric sender IDs must be registered with Africa's Talking first, and
# are ALWAYS rejected on sandbox with "InvalidSenderId". The adapter detects
# that and retries once without it, so messages still go out from the shared
# short code. Leave blank unless you have a registered ID.
AT_SENDER_ID="VIWANDA"

# The seeded demo personas use invented Tanzanian numbers. On a live (non
# sandbox) account those digits belong to real people, so the adapter refuses
# them. Set this to true only if you know what you are doing.
# AT_ALLOW_DEMO_NUMBERS="false"
