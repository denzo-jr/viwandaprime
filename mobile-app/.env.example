# Mirrors the root .env. Copy to .env before running.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-secret"

# Africa's Talking. Blank AT_API_KEY = simulator mode (nothing is sent).
# AT_USERNAME=sandbox delivers only to the provider simulator, never a handset.
AT_USERNAME="sandbox"
AT_API_KEY=""

# Alphanumeric sender IDs must be registered, and are always rejected on
# sandbox. The adapter retries once without it, so messages still go out.
AT_SENDER_ID="VIWANDA"

# USSD short code shown in the UI (the webhook ignores serviceCode).
NEXT_PUBLIC_USSD_CODE="*384*42642#"
