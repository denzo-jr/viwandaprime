    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "^4.3.3",
